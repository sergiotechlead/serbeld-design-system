{
  "name": "@serbeld/signal",
  "version": "1.0.0",
  "description": "Signal — Sergio Beleño's interface system for serbeld.space: tokens, React components, brand docs and assets.",
  "author": "Sergio Beleño <serbeldiaz@gmail.com>",
  "homepage": "https://www.serbeld.space",
  "private": true,
  "type": "module",
  "main": "./dist/signal.esm.js",
  "module": "./dist/signal.esm.js",
  "types": "./dist/types/index.d.ts",
  "style": "./dist/signal.css",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/signal.esm.js"
    },
    "./tokens.css": "./tokens/tokens.css",
    "./tokens.json": "./tokens/tokens.json",
    "./signal.css": "./dist/signal.css"
  },
  "files": ["dist", "tokens", "fonts", "assets"],
  "sideEffects": ["*.css"],
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "esbuild": "0.24.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.6.3"
  }
}
